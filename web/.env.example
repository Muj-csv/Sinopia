# Copy to .env.local and fill in -- see docs/SETUP.md for where each value comes from.
# Client-visible (VITE_ prefix, protected by Supabase RLS / scoped tokens):
VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=
VITE_MAPILLARY_TOKEN=

# Server-only (Vercel env, never committed, never sent to the browser):
OPENVERSE_CLIENT_ID=
OPENVERSE_CLIENT_SECRET=
